          <div className="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-[200px]">
            {/* Large - AI Exam Generator */}
            <div className="md:col-span-2 md:row-span-2 group rounded-[24px] bg-gradient-to-br from-[#2563EB]/10 to-[#06B6D4]/10 p-8 border border-white/10 hover:border-[#2563EB]/50 transition-all relative overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-br from-[#2563EB]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
              <div className="relative">
                <Brain className="w-12 h-12 text-[#2563EB] mb-4" />
                <h3 className="text-2xl font-bold mb-3">AI Exam Generator</h3>
                <p className="text-gray-400 mb-4">Create comprehensive exams in seconds with intelligent question generation</p>
                <div className="space-y-2">
                  <div className="flex items-center gap-2 text-sm text-gray-400">
                    <Check className="w-4 h-4 text-[#10B981]" />
                    <span>Auto-generate from content</span>
                  </div>
                  <div className="flex items-center gap-2 text-sm text-gray-400">
                    <Check className="w-4 h-4 text-[#10B981]" />
                    <span>Multiple question types</span>
                  </div>
                  <div className="flex items-center gap-2 text-sm text-gray-400">
                    <Check className="w-4 h-4 text-[#10B981]" />
                    <span>Difficulty adjustment</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Medium - Marketplace */}
            <div className="md:col-span-2 group rounded-[24px] bg-gradient-to-br from-[#1E293B] to-[#0F172A] p-6 border border-white/10 hover:border-[#06B6D4]/50 transition-all relative overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-br from-[#06B6D4]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
              <div className="relative">
                <Globe className="w-10 h-10 text-[#06B6D4] mb-3" />
                <h3 className="text-xl font-bold mb-2">Resource Marketplace</h3>
                <p className="text-sm text-gray-400">Monetize your expertise with flexible pricing</p>
              </div>
            </div>

            {/* Small - Analytics */}
            <div className="group rounded-[24px] bg-gradient-to-br from-[#1E293B] to-[#0F172A] p-6 border border-white/10 hover:border-[#10B981]/50 transition-all relative overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-br from-[#10B981]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
              <div className="relative">
                <BarChart3 className="w-10 h-10 text-[#10B981] mb-3" />
                <h3 className="text-lg font-bold mb-2">Analytics</h3>
                <p className="text-xs text-gray-400">Real-time insights</p>
              </div>
            </div>

            {/* Small - Verification */}
            <div className="group rounded-[24px] bg-gradient-to-br from-[#1E293B] to-[#0F172A] p-6 border border-white/10 hover:border-[#F59E0B]/50 transition-all relative overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-br from-[#F59E0B]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
              <div className="relative">
                <Shield className="w-10 h-10 text-[#F59E0B] mb-3" />
                <h3 className="text-lg font-bold mb-2">Verified</h3>
                <p className="text-xs text-gray-400">Trust system</p>
              </div>
            </div>

            {/* Wide - Question Bank */}
            <div className="md:col-span-4 group rounded-[24px] bg-gradient-to-r from-[#1E293B] to-[#0F172A] p-6 border border-white/10 hover:border-purple-500/50 transition-all relative overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-r from-purple-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
              <div className="relative flex items-center justify-between">
                <div>
                  <Sparkles className="w-10 h-10 text-purple-400 mb-3" />
                  <h3 className="text-xl font-bold mb-2">Intelligent Question Bank</h3>
                  <p className="text-sm text-gray-400">Organized, searchable, and always expanding with AI</p>
                </div>
                <div className="hidden md:flex items-center gap-4">
                  {[1, 2, 3, 4].map((i) => (
                    <div key={i} className="w-32 h-20 rounded-xl bg-white/5 border border-white/10" />
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Interactive Workspace Selector */}
      <section id="workspace" className="py-32 px-6 bg-gradient-to-b from-transparent via-[#06B6D4]/5 to-transparent">
        <div className="max-w-7xl mx-auto">
          <div className="text-center mb-16">
            <span className="text-sm font-medium text-[#06B6D4] mb-4 block">CHOOSE YOUR WORKSPACE</span>
            <h2 className="text-5xl font-bold mb-6">Built for every role</h2>
            <p className="text-xl text-gray-400 mb-8">Switch between powerful dashboards</p>
            
            {/* Workspace Toggle */}
            <div className="inline-flex items-center gap-2 p-1 rounded-full bg-white/5 border border-white/10">
              <button
                onClick={() => setActiveWorkspace("teacher")}
                className={`px-8 py-3 rounded-full font-semibold transition-all ${
                  activeWorkspace === "teacher"
                    ? "bg-white text-black"
                    : "text-gray-400 hover:text-white"
                }`}
              >
                Teacher
              </button>
              <button
                onClick={() => setActiveWorkspace("admin")}
                className={`px-8 py-3 rounded-full font-semibold transition-all ${
                  activeWorkspace === "admin"
                    ? "bg-white text-black"
                    : "text-gray-400 hover:text-white"
                }`}
              >
                Administrator
              </button>
            </div>
          </div>

          {/* Workspace Preview */}
          <div className="relative">
            <div className="absolute inset-0 bg-gradient-to-r from-[#2563EB]/20 to-[#06B6D4]/20 blur-3xl" />
            <div className="relative rounded-[32px] overflow-hidden border border-white/10 bg-gradient-to-br from-[#1E293B] to-[#0F172A] p-2">
              {/* Browser Chrome */}
              <div className="h-12 bg-gradient-to-r from-[#0F172A] to-[#1E293B] rounded-t-[24px] flex items-center px-4 gap-2 border-b border-white/10">
                <div className="flex gap-2">
                  <div className="w-3 h-3 rounded-full bg-red-500/50" />
                  <div className="w-3 h-3 rounded-full bg-yellow-500/50" />
                  <div className="w-3 h-3 rounded-full bg-green-500/50" />
                </div>
                <div className="flex-1 max-w-md mx-auto bg-white/5 rounded-lg px-4 py-1.5 text-xs text-gray-500">
                  edushare.com/{activeWorkspace}-dashboard
                </div>
              </div>

              {/* Dashboard Content */}
              <div className="p-8 bg-gradient-to-br from-[#0F172A] to-[#1E293B]">
                {activeWorkspace === "teacher" ? (
                  <div className="space-y-6">
                    {/* Teacher Dashboard */}
                    <div className="flex items-center justify-between mb-8">
                      <div>
                        <h3 className="text-2xl font-bold mb-1">Welcome back, Professor</h3>
                        <p className="text-gray-400">Here's your teaching overview</p>
                      </div>
                      <button className="px-6 py-3 rounded-full bg-gradient-to-r from-[#2563EB] to-[#06B6D4] text-white font-semibold">
                        Upload Resource
                      </button>
                    </div>

                    <div className="grid grid-cols-4 gap-4">
                      <div className="rounded-[20px] bg-gradient-to-br from-blue-500/20 to-blue-600/20 p-6 border border-blue-500/30">
                        <Users className="w-8 h-8 text-blue-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">2,847</div>
                        <div className="text-sm text-gray-400">Active Students</div>
                      </div>
                      <div className="rounded-[20px] bg-gradient-to-br from-cyan-500/20 to-cyan-600/20 p-6 border border-cyan-500/30">
                        <FileText className="w-8 h-8 text-cyan-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">156</div>
                        <div className="text-sm text-gray-400">Resources</div>
                      </div>
                      <div className="rounded-[20px] bg-gradient-to-br from-green-500/20 to-green-600/20 p-6 border border-green-500/30">
                        <DollarSign className="w-8 h-8 text-green-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">$12.5k</div>
                        <div className="text-sm text-gray-400">Revenue</div>
                      </div>
                      <div className="rounded-[20px] bg-gradient-to-br from-purple-500/20 to-purple-600/20 p-6 border border-purple-500/30">
                        <Sparkles className="w-8 h-8 text-purple-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">47</div>
                        <div className="text-sm text-gray-400">AI Exams</div>
                      </div>
                    </div>

                    <div className="rounded-[20px] bg-white/5 p-6 border border-white/10">
                      <div className="flex items-center justify-between mb-4">
                        <h4 className="font-semibold">Recent Activity</h4>
                        <span className="text-xs text-gray-500">Last 7 days</span>
                      </div>
                      <div className="flex items-end gap-2 h-32">
                        {[40, 65, 45, 80, 55, 90, 70].map((height, i) => (
                          <div key={i} className="flex-1 bg-gradient-to-t from-[#2563EB] to-[#06B6D4] rounded-t-lg transition-all hover:opacity-80" style={{ height: `${height}%` }} />
                        ))}
                      </div>
                    </div>
                  </div>
                ) : (
                  <div className="space-y-6">
                    {/* Admin Dashboard */}
                    <div className="flex items-center justify-between mb-8">
                      <div>
                        <h3 className="text-2xl font-bold mb-1">Admin Control Center</h3>
                        <p className="text-gray-400">Platform overview and management</p>
                      </div>
                      <button className="px-6 py-3 rounded-full bg-gradient-to-r from-orange-500 to-red-500 text-white font-semibold">
                        View Reports
                      </button>
                    </div>

                    <div className="grid grid-cols-4 gap-4">
                      <div className="rounded-[20px] bg-gradient-to-br from-orange-500/20 to-orange-600/20 p-6 border border-orange-500/30">
                        <Users className="w-8 h-8 text-orange-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">10,234</div>
                        <div className="text-sm text-gray-400">Total Users</div>
                      </div>
                      <div className="rounded-[20px] bg-gradient-to-br from-purple-500/20 to-purple-600/20 p-6 border border-purple-500/30">
                        <Shield className="w-8 h-8 text-purple-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">27</div>
                        <div className="text-sm text-gray-400">Pending Verifications</div>
                      </div>
                      <div className="rounded-[20px] bg-gradient-to-br from-green-500/20 to-green-600/20 p-6 border border-green-500/30">
                        <TrendingUp className="w-8 h-8 text-green-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">+127%</div>
                        <div className="text-sm text-gray-400">Growth</div>
                      </div>
                      <div className="rounded-[20px] bg-gradient-to-br from-blue-500/20 to-blue-600/20 p-6 border border-blue-500/30">
                        <FileText className="w-8 h-8 text-blue-400 mb-3" />
                        <div className="text-3xl font-bold mb-1">1.2M</div>
                        <div className="text-sm text-gray-400">Resources</div>
                      </div>
                    </div>

                    <div className="grid grid-cols-2 gap-4">
                      <div className="rounded-[20px] bg-white/5 p-6 border border-white/10">
                        <h4 className="font-semibold mb-4">Recent Verifications</h4>
                        <div className="space-y-3">
                          {[1, 2, 3].map((i) => (
                            <div key={i} className="flex items-center gap-3 p-3 rounded-lg bg-white/5">
                              <div className="w-10 h-10 rounded-full bg-gradient-to-br from-[#2563EB] to-[#06B6D4]" />
                              <div className="flex-1">
                                <div className="text-sm font-medium">Teacher {i}</div>
                                <div className="text-xs text-gray-500">Mathematics</div>
                              </div>
                              <button className="text-xs px-3 py-1 rounded-full bg-yellow-500/20 text-yellow-400">Pending</button>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div className="rounded-[20px] bg-white/5 p-6 border border-white/10">
                        <h4 className="font-semibold mb-4">Platform Activity</h4>
                        <div className="space-y-3">
                          <div className="flex items-center justify-between text-sm">
                            <span className="text-gray-400">New Uploads Today</span>
                            <span className="font-bold text-cyan-400">248</span>
                          </div>
                          <div className="flex items-center justify-between text-sm">
                            <span className="text-gray-400">AI Exams Generated</span>
                            <span className="font-bold text-purple-400">532</span>
                          </div>
                          <div className="flex items-center justify-between text-sm">
                            <span className="text-gray-400">Resources Sold</span>
                            <span className="font-bold text-green-400">129</span>
                          </div>
                          <div className="flex items-center justify-between text-sm">
                            <span className="text-gray-400">Active Sessions</span>
                            <span className="font-bold text-orange-400">3,421</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Live Metrics Dashboard */}
      <section className="py-32 px-6">
        <div className="max-w-7xl mx-auto">
          <div className="text-center mb-16">
            <span className="text-sm font-medium text-[#06B6D4] mb-4 block">REAL-TIME IMPACT</span>
            <h2 className="text-5xl font-bold mb-6">Platform in action</h2>
            <p className="text-xl text-gray-400">Live metrics from our ecosystem</p>
          </div>

          <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
            {[
              { label: "Today's Uploads", value: "248", icon: Upload, color: "from-blue-500 to-blue-600" },
              { label: "AI Exams Generated", value: "532", icon: Brain, color: "from-purple-500 to-purple-600" },
              { label: "Resources Sold", value: "129", icon: DollarSign, color: "from-green-500 to-green-600" },
              { label: "Verified Teachers Today", value: "27", icon: Award, color: "from-orange-500 to-orange-600" },
            ].map((metric, index) => (
              <div key={index} className="group rounded-[24px] bg-gradient-to-br from-[#1E293B] to-[#0F172A] p-6 border border-white/10 hover:border-white/20 transition-all">
                <div className={`w-12 h-12 rounded-2xl bg-gradient-to-br ${metric.color} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}>
                  <metric.icon className="w-6 h-6 text-white" />
                </div>
                <div className="text-4xl font-bold mb-2">{metric.value}</div>
                <div className="text-sm text-gray-400">{metric.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Marketplace Preview */}
      <section id="marketplace" className="py-32 px-6 bg-gradient-to-b from-transparent via-[#10B981]/5 to-transparent">
        <div className="max-w-7xl mx-auto">
          <div className="text-center mb-16">
            <span className="text-sm font-medium text-[#06B6D4] mb-4 block">MARKETPLACE</span>
            <h2 className="text-5xl font-bold mb-6">Monetize your expertise</h2>
            <p className="text-xl text-gray-400 mb-8">Sell resources or share for free</p>
          </div>

          {/* Search Bar */}
          <div className="max-w-2xl mx-auto mb-12">
            <div className="relative">
              <input
                type="text"
                placeholder="Search Math, Physics, Programming..."
                className="w-full px-6 py-4 rounded-full bg-white/5 border border-white/10 text-white placeholder:text-gray-500 outline-none focus:border-[#2563EB] transition-all"
              />
              <button className="absolute right-2 top-1/2 -translate-y-1/2 px-6 py-2 rounded-full bg-gradient-to-r from-[#2563EB] to-[#06B6D4] text-white font-semibold">
                Search
              </button>
            </div>
          </div>

          {/* Resource Cards */}
          <div className="grid md:grid-cols-3 gap-6">
            {[
              { title: "Calculus Fundamentals", subject: "Mathematics", price: "$3.99", rating: 5, downloads: "2.4k" },
              { title: "Quantum Physics", subject: "Physics", price: "$4.99", rating: 5, downloads: "1.8k" },
              { title: "Python Programming", subject: "Computer Science", price: "Free", rating: 5, downloads: "5.2k" },
            ].map((resource, index) => (
              <div key={index} className="group rounded-[24px] bg-gradient-to-br from-[#1E293B] to-[#0F172A] overflow-hidden border border-white/10 hover:border-white/20 transition-all hover:scale-105">
                <div className="h-40 bg-gradient-to-br from-[#2563EB]/20 to-[#06B6D4]/20 flex items-center justify-center border-b border-white/10">
                  <FileText className="w-16 h-16 text-[#2563EB]" />
                </div>
                <div className="p-6">
                  <div className="flex items-center gap-2 mb-2">
                    <span className="text-xs px-2 py-1 rounded-full bg-[#2563EB]/20 text-[#2563EB]">{resource.subject}</span>
                    <div className="flex items-center gap-1 text-xs text-yellow-400">
                      {[...Array(resource.rating)].map((_, i) => (
                        <span key={i}>★</span>
                      ))}
                    </div>
                  </div>
                  <h3 className="text-lg font-bold mb-2">{resource.title}</h3>
                  <div className="flex items-center justify-between">
                    <span className="text-xl font-bold text-[#10B981]">{resource.price}</span>
                    <span className="text-sm text-gray-400">{resource.downloads} downloads</span>
                  </div>
                  <button className="w-full mt-4 py-2 rounded-full bg-white/5 hover:bg-white/10 transition-all text-sm font-medium">
                    Preview
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Testimonials */}
      <section className="py-32 px-6">
        <div className="max-w-7xl mx-auto">
          <div className="text-center mb-16">
            <span className="text-sm font-medium text-[#06B6D4] mb-4 block">TESTIMONIALS</span>
            <h2 className="text-5xl font-bold mb-6">Loved by educators</h2>
          </div>

          <div className="grid md:grid-cols-3 gap-6">
            {[
              {
                name: "Dr. Sarah Chen",
                role: "University Professor",
                text: "EduShare's AI tools save me 10+ hours every week. The exam generator is incredible.",
                avatar: "SC",
              },
              {
                name: "Ahmed Hassan",
                role: "High School Teacher",
                text: "I've earned over $15k selling my resources. This platform changed my life.",
                avatar: "AH",
              },
              {
                name: "Maria Rodriguez",
                role: "Private Tutor",
                text: "The analytics help me understand exactly what my students need. Game-changer.",
                avatar: "MR",
              },
            ].map((testimonial, index) => (
              <div key={index} className="rounded-[24px] bg-gradient-to-br from-[#1E293B] to-[#0F172A] p-8 border border-white/10">
                <div className="flex gap-1 mb-4 text-yellow-400">
                  {[...Array(5)].map((_, i) => (
                    <span key={i}>★</span>
                  ))}
                </div>
                <p className="text-gray-300 leading-relaxed mb-6">"{testimonial.text}"</p>
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 rounded-full bg-gradient-to-br from-[#2563EB] to-[#06B6D4] flex items-center justify-center text-sm font-bold">
                    {testimonial.avatar}
                  </div>
                  <div>
                    <div className="font-semibold">{testimonial.name}</div>
                    <div className="text-sm text-gray-400">{testimonial.role}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Final CTA */}
      <section className="py-32 px-6">
        <div className="max-w-4xl mx-auto text-center">
          <div className="relative">
            <div className="absolute inset-0 bg-gradient-to-r from-[#2563EB] to-[#06B6D4] blur-3xl opacity-30" />
            <div className="relative rounded-[32px] bg-gradient-to-br from-[#1E293B] to-[#0F172A] p-16 border border-white/10">
              <h2 className="text-5xl font-bold mb-6">
                Ready to transform education?
              </h2>
              <p className="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
                Join thousands of educators using AI to teach smarter, create faster, and inspire globally.
              </p>
              <div className="flex flex-col sm:flex-row items-center justify-center gap-4">
                <button 
                  onClick={() => router.push("/auth")}
                  className="group px-10 py-5 rounded-full bg-white text-black font-semibold text-lg hover:scale-105 transition-all flex items-center gap-2"
                >
                  Start Free Trial
                  <ArrowRight className="w-6 h-6 group-hover:translate-x-1 transition-transform" />
                </button>
                <button className="px-10 py-5 rounded-full bg-white/5 backdrop-blur-sm text-white font-semibold text-lg hover:bg-white/10 transition-all border border-white/10">
                  Talk to Sales
                </button>
              </div>
              <p className="text-sm text-gray-500 mt-6">
                No credit card required • 14-day free trial • Cancel anytime
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Footer */}
      <footer className="border-t border-white/10 py-12 px-6">
        <div className="max-w-7xl mx-auto">
          <div className="grid md:grid-cols-4 gap-8 mb-8">
            <div>
              <div className="flex items-center gap-2 mb-4">
                <div className="w-8 h-8 rounded-xl bg-gradient-to-br from-[#2563EB] to-[#06B6D4] flex items-center justify-center">
                  <BookOpen className="w-4 h-4 text-white" />
                </div>
                <span className="font-bold">EduShare</span>
              </div>
              <p className="text-sm text-gray-400">
                The modern platform for educational excellence
              </p>
            </div>
            
            {[
              { title: "Product", links: ["Features", "Pricing", "Security", "Roadmap"] },
              { title: "Company", links: ["About", "Blog", "Careers", "Contact"] },
              { title: "Legal", links: ["Privacy", "Terms", "Security", "Compliance"] },
            ].map((section, i) => (
              <div key={i}>
                <h4 className="font-semibold mb-4">{section.title}</h4>
                <ul className="space-y-2">
                  {section.links.map((link, j) => (
                    <li key={j}>
                      <a href="#" className="text-sm text-gray-400 hover:text-white transition-colors">{link}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          
          <div className="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-400">
            <p>© 2024 EduShare. All rights reserved.</p>
            <div className="flex gap-6">
              <a href="#" className="hover:text-white transition-colors">Twitter</a>
              <a href="#" className="hover:text-white transition-colors">LinkedIn</a>
              <a href="#" className="hover:text-white transition-colors">GitHub</a>
            </div>
          </div>
        </div>
      </footer>
    </div>
  );
}
