{
  "info": {
    "name": "DeepSeek AI - EduShare",
    "description": "API endpoints for DeepSeek AI integration in EduShare platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Get Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@university.tn\",\n  \"password\": \"Teacher123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login to get JWT token. Copy the access_token from response and set it as the 'token' variable."
          }
        }
      ]
    },
    {
      "name": "AI Endpoints",
      "item": [
        {
          "name": "Check AI Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/status",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "status"]
            },
            "description": "Check if DeepSeek AI is properly configured"
          }
        },
        {
          "name": "Chat with AI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain machine learning in simple terms\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/chat",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "chat"]
            },
            "description": "General-purpose chat with DeepSeek AI"
          }
        },
        {
          "name": "Chat with Context",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"What are neural networks?\",\n  \"context\": \"You are a university professor teaching AI to medical students. Use medical analogies.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/chat",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "chat"]
            },
            "description": "Chat with custom system context"
          }
        },
        {
          "name": "Summarize Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Machine learning is a method of data analysis that automates analytical model building. It is a branch of artificial intelligence based on the idea that systems can learn from data, identify patterns and make decisions with minimal human intervention. Because of new computing technologies, machine learning today is not like machine learning of the past. It was born from pattern recognition and the theory that computers can learn without being programmed to perform specific tasks; researchers interested in artificial intelligence wanted to see if computers could learn from data.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/summarize",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "summarize"]
            },
            "description": "Generate a concise summary of long text"
          }
        },
        {
          "name": "Translate to French",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, how are you today?\",\n  \"targetLanguage\": \"French\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/translate",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "translate"]
            },
            "description": "Translate text to French"
          }
        },
        {
          "name": "Translate to Arabic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Good morning, I would like to schedule an appointment.\",\n  \"targetLanguage\": \"Arabic\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/translate",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "translate"]
            },
            "description": "Translate text to Arabic"
          }
        },
        {
          "name": "Generate Professional Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Request a meeting with the department head to discuss project timeline and resource allocation\",\n  \"tone\": \"professional\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate-email",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "generate-email"]
            },
            "description": "Generate a professional email"
          }
        },
        {
          "name": "Generate Friendly Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Thank a colleague for their help on a recent project\",\n  \"tone\": \"friendly\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate-email",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "generate-email"]
            },
            "description": "Generate a friendly email"
          }
        },
        {
          "name": "Generate Formal Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Inform students about upcoming exam schedule changes and new policies\",\n  \"tone\": \"formal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate-email",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "generate-email"]
            },
            "description": "Generate a formal email"
          }
        }
      ]
    },
    {
      "name": "Educational Use Cases",
      "item": [
        {
          "name": "Explain Medical Concept",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain the cardiac cycle in detail\",\n  \"context\": \"You are a cardiology professor. Explain in a way that medical students can understand.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/chat",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "chat"]
            },
            "description": "Use AI to explain medical concepts"
          }
        },
        {
          "name": "Generate Study Questions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Generate 5 multiple choice questions about the respiratory system\",\n  \"context\": \"You are creating exam questions for 2nd year medical students.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/chat",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "chat"]
            },
            "description": "Generate study questions for students"
          }
        },
        {
          "name": "Summarize Research Paper",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"[Paste research paper abstract or content here - up to 10000 characters]\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/summarize",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "summarize"]
            },
            "description": "Summarize research papers for students"
          }
        }
      ]
    }
  ]
}
